<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ロシア語単語帳</title>

<style>
body {
  font-family: sans-serif;
  background: #f2f4f8;
  text-align: center;
  padding: 20px;
}

.card {
  background: white;
  border-radius: 20px;
  padding: 30px;
  margin-top: 20px;
}

.word {
  font-size: 32px;
  font-weight: bold;
}

.meaning {
  display: none;
  margin-top: 10px;
  color: #666;
}

.forms {
  margin-top: 15px;
  text-align: left;
  display: none;
}

.forms div {
  padding: 5px 0;
}

button {
  margin: 5px;
  padding: 12px;
  border: none;
  border-radius: 10px;
  color: white;
}

.btn-main { background: green; }
.btn-next { background: blue; }
.btn-audio { background: purple; }
.btn-fav { background: orange; }
.btn-forms { background: #555; }

.mode-screen button {
  display: block;
  width: 100%;
  background: #444;
}
</style>
</head>

<body>

<h2>ロシア語単語帳</h2>

<div id="modeScreen">
  <button onclick="start('random')">ランダム</button>
  <button onclick="start('noun')">名詞</button>
  <button onclick="start('verb')">動詞</button>
  <button onclick="start('adj')">形容詞</button>
  <button onclick="start('other')">その他</button>
  <button onclick="start('fav')">お気に入り</button>
</div>

<div id="app" style="display:none;">
  <div class="card" onclick="showMeaning()">
    <div id="word" class="word"></div>
    <div id="meaning" class="meaning"></div>
    <div id="forms" class="forms"></div>
  </div>

  <div>
    <button class="btn-main" onclick="showMeaning()">答え</button>
    <button class="btn-next" onclick="nextWord()">次へ</button>
    <button class="btn-audio" onclick="speak()">🔊</button>
    <button class="btn-fav" onclick="toggleFavorite()">⭐</button>
    <button class="btn-forms" onclick="toggleForms()">変化</button>
  </div>
</div>

<script>
let data = [];
let current = null;
let mode = "random";
let fav = JSON.parse(localStorage.getItem("fav")) || [];

fetch("./russian_words.json")
  .then(res => res.json())
  .then(json => data = json);

function start(m) {
  mode = m;
  document.getElementById("modeScreen").style.display = "none";
  document.getElementById("app").style.display = "block";
  nextWord();
}

function nextWord() {
  let pool = data;

  if (mode === "noun") pool = data.filter(d => d.type === "noun");
  if (mode === "verb") pool = data.filter(d => d.type === "verb");
  if (mode === "adj") pool = data.filter(d => d.type === "adj");
  if (mode === "fav") pool = data.filter(d => fav.includes(d.word));

  if (pool.length === 0) pool = data;

  current = pool[Math.floor(Math.random() * pool.length)];

  document.getElementById("word").innerText = current.word;
  document.getElementById("meaning").style.display = "none";
  document.getElementById("forms").style.display = "none";

  renderForms();
  speak();
}

function showMeaning() {
  const el = document.getElementById("meaning");
  el.innerText = current.meaning;
  el.style.display = "block";
}

function renderForms() {
  const box = document.getElementById("forms");
  box.innerHTML = "";

  if (!current.forms) return;

  for (let key in current.forms) {
    const div = document.createElement("div");
    div.innerText = key + "： " + current.forms[key];
    box.appendChild(div);
  }
}

function toggleForms() {
  const el = document.getElementById("forms");
  el.style.display = el.style.display === "none" ? "block" : "none";
}

function speak() {
  const u = new SpeechSynthesisUtterance(current.word);
  u.lang = "ru-RU";
  speechSynthesis.cancel();
  speechSynthesis.speak(u);
}

function toggleFavorite() {
  if (fav.includes(current.word)) {
    fav = fav.filter(f => f !== current.word);
  } else {
    fav.push(current.word);
  }
  localStorage.setItem("fav", JSON.stringify(fav));
}
</script>

</body>
</html>
